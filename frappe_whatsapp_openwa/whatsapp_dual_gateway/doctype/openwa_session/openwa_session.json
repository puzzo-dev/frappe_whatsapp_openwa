  },
  {
   "fieldname": "qr_code_data",
   "fieldtype": "Long Text",
   "label": "QR Code Data (base64)",
   "read_only": 1
  },
  {
   "fieldname": "section_break_3",
   "fieldtype": "Section Break",
   "label": "Rate Limiting"
  },
  {
   "default": "0",
   "fieldname": "messages_sent_today",
   "fieldtype": "Int",
   "label": "Messages Sent Today",
   "read_only": 1,
   "description": "Counts toward this session's cap and the gateway-wide limit. Resets at midnight."
  },
  {
   "default": "1000",
   "fieldname": "daily_soft_cap",
   "fieldtype": "Int",
   "label": "Daily Soft Cap",
   "description": "Most messages this number may send in a day. 0 means no cap for this session. The gateway-wide Daily Send Limit in OpenWA Gateway Settings applies as well — whichever is reached first stops the send."
  },
  {
   "fieldname": "send_rate_window_seconds",
   "fieldtype": "Int",
   "label": "Send Rate Window (seconds)",
   "default": "60"
  },
  {
   "fieldname": "max_restart_attempts",
   "fieldtype": "Int",
   "label": "Max Auto-Restart Attempts",
   "default": "3",
   "description": "After this many failed restarts the self-healer marks this session Failed and asks for a human."
  },
  {
   "fieldname": "pairing_code_max_requests",
   "fieldtype": "Int",
   "label": "Max Pairing Code Requests",
   "default": "5",
   "description": "Per window. WhatsApp throttles device linking and can block a number that asks too often."
  },
  {
   "fieldname": "pairing_code_window_seconds",
   "fieldtype": "Int",
   "label": "Pairing Code Window (seconds)",
   "default": "600"
  },
  {
   "fieldname": "webhook_rate_limit_max",
   "fieldtype": "Int",
   "label": "Max Webhook Events per Window",
   "default": "200",
   "description": "Inbound events accepted for this session before bursts are rejected."
  },
  {
   "fieldname": "webhook_rate_limit_window_seconds",
   "fieldtype": "Int",
   "label": "Webhook Rate Limit Window (seconds)",
   "default": "60"
  },
  {
   "fieldname": "send_rate_max",
   "fieldtype": "Int",
   "label": "Max Sends per Window",
   "default": "20",
   "description": "How fast this number may send. Separate from Daily Soft Cap: that bounds the day's total, this bounds the pace — a campaign that respects 1000/day by firing them in two minutes is what gets a number blocked."
  },
  {
   "fieldname": "last_message_sent",
