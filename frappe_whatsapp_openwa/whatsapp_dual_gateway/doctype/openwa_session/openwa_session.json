 "fields": [
  {
   "fieldname": "session_name",
   "fieldtype": "Data",
   "label": "Session Name",
   "reqd": 1,
   "unique": 1
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company"
  },
  {
   "fieldname": "phone_number",
   "fieldtype": "Data",
   "label": "Phone Number (E.164)",
   "reqd": 1,
   "unique": 1,
   "description": "The WhatsApp number this session drives. One number, one session — stored in E.164 form so the same number cannot be added again in a different format."
  },
  {
   "fieldname": "linked_whatsapp_account",
   "fieldtype": "Link",
   "label": "WhatsApp Account",
   "options": "WhatsApp Account"
  },
  {
   "default": "0",
   "depends_on": "linked_whatsapp_account",
   "description": "Use this session when the linked account sends via OpenWA. Only one session per account can be the default; setting it here clears it on the others.",
   "fieldname": "is_default",
   "fieldtype": "Check",
   "in_list_view": 1,
   "label": "Default Session for Account"
  },
  {
   "fieldname": "gateway_session_id",
   "fieldtype": "Data",
   "label": "Gateway Session ID",
   "read_only": 1,
   "search_index": 1
  },
  {
   "fieldname": "webhook_secret",
   "fieldtype": "Password",
   "label": "Webhook Secret",
   "read_only": 1,
   "description": "Signs this session's webhook deliveries. Generated on provisioning and registered with the gateway, so a leaked secret exposes only this session and can be rotated without touching the others."
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Initializing\nQR Required\nConnected\nDisconnected\nFailed",
   "default": "Initializing",
   "in_list_view": 1,
   "read_only": 1,
   "reqd": 1,
   "search_index": 1
  },
  {
   "default": "0",
   "fieldname": "requires_human_attention",
   "fieldtype": "Check",
   "label": "Requires Human Attention",
   "read_only": 1
  },
  {
   "default": "0",
   "fieldname": "skip_auto_heal",
   "fieldtype": "Check",
   "label": "Skip Auto-Heal"
  },
  {
   "fieldname": "last_state_change",
   "fieldtype": "Datetime",
   "label": "Last State Change",
   "read_only": 1
  },
  {
   "fieldname": "last_health_check",
   "fieldtype": "Datetime",
   "label": "Last Health Check",
   "read_only": 1
  },
  {
   "fieldname": "section_break_2",
   "fieldtype": "Section Break",
   "label": "QR Code",
